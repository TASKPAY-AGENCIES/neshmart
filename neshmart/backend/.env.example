# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/neshmart

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Daraja (Safaricom) - Sandbox values from https://developer.safaricom.co.ke
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
BUSINESS_SHORTCODE=174379
PASSKEY=
CALLBACK_URL=https://your-deployed-backend.onrender.com/api/mpesa/callback
B2C_SHORTCODE=
B2C_INITIATOR_NAME=
B2C_SECURITY_CREDENTIAL=
B2C_QUEUE_TIMEOUT_URL=https://your-deployed-backend.onrender.com/api/mpesa/b2c/timeout
B2C_RESULT_URL=https://your-deployed-backend.onrender.com/api/mpesa/b2c/result

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Platform
PLATFORM_FEE_PERCENT=0.05
